# FightSafe AI — commit source, configs, docs, and curated data; ignore local media & runs.

# --- Python
__pycache__/
*.pyc
*.py[cod]
*$py.class
.eggs/

# --- Environments
.venv/
venv/
ENV/
env/
.env
.env.*
!.env.example
!.env.sample
.python-version
.tool-versions
.direnv/
.envrc
!.envrc.example

# --- Testing / coverage / typecheck
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.lcov
junit.xml
test-results/
.cache/
.hypothesis/
.tox/
.nox/
validation/

# --- Build
dist/
build/
*.egg-info/
*.egg
MANIFEST
pip-log.txt
pip-wheel-metadata/
*.whl
develop-eggs/
sdist/
wheels/

# --- IDE / OS
.vscode/
.idea/
.cursor/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini

# --- Logs
logs/
log/
*.log
*.log.*
x.log

